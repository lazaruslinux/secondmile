# Copy this file to .env and fill in every value. The .env file is never
# committed, so your secrets stay off GitHub. The backend refuses to start
# while any value below still says change-me.

# Postgres credentials. The database is only reachable from inside the compose
# network, but pick a real password anyway: openssl rand -hex 24
POSTGRES_USER=secondmile
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secondmile

# Connection string the backend uses. Keep the user, password, and database
# name in sync with the three values above. "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://secondmile:change-me@db:5432/secondmile

# Set to false only for plain-http local development. Behind HTTPS (any real
# deployment) leave it true so the session cookie is never sent in the clear.
COOKIE_SECURE=true

# How long a login lasts, in hours. 720 is thirty days.
SESSION_HOURS=720

# Timezone used to group workouts into days and weeks in the Almanac.
# Use your own, e.g. America/Chicago.
TZ=UTC

# Daily distance caps per activity, in miles. Workouts that push a day past
# these are still imported but carry a flag, so a bad sync or a typo in manual
# entry never silently inflates anyone's totals. Raise them if you are really
# covering more ground than this.
DAILY_CAP_WALK_MI=40
DAILY_CAP_RUN_MI=40
DAILY_CAP_CYCLE_MI=200
DAILY_CAP_SWIM_MI=10
