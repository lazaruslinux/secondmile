# Copy this file to .env and fill in every value. The .env file is never
# committed, so your secrets stay off GitHub. The backend refuses to start
# while any value below still says change-me.

# Postgres credentials. The database is only reachable from inside the compose
# network, but pick a real password anyway: openssl rand -hex 24
POSTGRES_USER=secondmile
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secondmile

# Connection string the backend uses. Keep the user, password, and database
# name in sync with the three values above. "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://secondmile:change-me@db:5432/secondmile

# Set to false only for plain-http local development. Behind HTTPS (any real
# deployment) leave it true so the session cookie is never sent in the clear.
COOKIE_SECURE=true

# How long a login lasts, in hours. 720 is thirty days.
SESSION_HOURS=720

# Who may create an account. false keeps the instance invite-only: people
# register with a code from "manage.py create-invite" and nobody else gets in.
# true lets anyone who can reach the site sign up. Either way the address has
# to be verified before the account can sign in.
REGISTRATION_OPEN=false

# The address people type to reach this instance, used to build the link in the
# verification email. Get this wrong and the links point somewhere that is not
# your site. Include the scheme and no trailing path.
SITE_URL=https://game.example.com

# Where verification email is sent from. Leave SMTP_HOST empty and no mail is
# sent at all: the verification link is written to the backend log instead
# (docker compose logs backend), which is a fine way to run a private instance
# for people you can hand a link to. See docs/01-self-hosting.md.
# Port 587 negotiates TLS with STARTTLS and 465 is TLS from the first byte;
# both work, and the port is what decides which.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address on the message. Many providers reject a From they have not
# verified, so this usually has to be an address on your own domain.
SMTP_FROM=secondmile@example.com

# Timezone used to group workouts into days and weeks in the Almanac.
# Use your own, e.g. America/Chicago.
TZ=UTC

# Where profile pictures are stored inside the backend container. The compose
# file mounts a named volume here, so avatars survive a rebuild. Change it only
# if you also change that volume's mount path. Uploads are capped at 5 MB and
# re-encoded to a 512 by 512 webp with all metadata stripped, so what lands
# here is never the file somebody uploaded.
AVATAR_DIR=/data/avatars

# Where photos attached to workouts are stored inside the backend container.
# The compose file mounts a second named volume here, so photos survive a
# rebuild. Change it only if you also change that volume's mount path. Uploads
# are capped at 10 MB and re-encoded to a webp no more than 1600 pixels on its
# longest edge with all metadata stripped, so nothing that lands here carries
# the camera, the date, or the GPS position the original file did.
PHOTO_DIR=/data/photos

# Daily distance caps per activity, in miles. Workouts that push a day past
# these are still imported but carry a flag, so a bad sync or a typo in manual
# entry never silently inflates anyone's totals. Raise them if you are really
# covering more ground than this.
DAILY_CAP_WALK_MI=40
DAILY_CAP_RUN_MI=40
DAILY_CAP_CYCLE_MI=200
DAILY_CAP_SWIM_MI=10

# How many proxies of your own sit in front of this app, beyond the one that
# ships with it. 0 is right for the compose file as it stands; raise it by one
# for each extra reverse proxy or tunnel you put in front, and never higher than
# the number you really run, because too high lets a caller choose which
# rate-limit bucket they land in.
TRUSTED_PROXY_HOPS=0
