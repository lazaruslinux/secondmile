# The human-edited dependency list. requirements.txt is compiled from it with
# exact versions and hashes; regenerate after editing (run from backend/):
#   pip install pip-tools && pip-compile --generate-hashes requirements.in

# The web framework the API is written against
fastapi

# The ASGI server that actually runs it; the [standard] extra brings the fast
# HTTP parser and the websocket support the game world will need later
uvicorn[standard]

# Loads settings from the environment and .env, which is where every secret
# and every tunable in this project lives
pydantic-settings

# The database layer: models, queries, and the savepoints that make ingest
# idempotent without a round trip per duplicate
sqlalchemy

# The PostgreSQL driver behind postgresql+psycopg:// URLs; [binary] ships the
# compiled libpq so the image needs no build toolchain
psycopg[binary]

# Schema migrations, applied automatically when the container starts
alembic

# Argon2id password hashing, the only thing standing between a stolen database
# dump and everyone's passwords
argon2-cffi

# Image decoding and re-encoding for profile pictures. The only safe way to
# find out whether an upload is really an image is to decode it, and the only
# way to be sure the stored file carries no EXIF, no location, and no embedded
# payload is to re-encode it from its pixels. Backend only.
pillow

# Starlette's multipart parser, which is what makes the avatar form readable
# at all and, more to the point, what enforces the upload size cap while the
# body is still arriving rather than after it has all been buffered
python-multipart

# Web push delivery: the VAPID signature and the RFC 8291 payload encryption
# that browsers demand before they will show a notification. Hand-rolling
# either is worse than the dependency. Held before 2.0 on purpose: the send
# runs synchronously from a background task, and 2.x hard-requires the whole
# aiohttp stack for an async path nothing here calls.
pywebpush<2
